# =====================================================
# Application Configuration
# =====================================================
APP_ENV=dev
API_PORT=8000
LOG_LEVEL=INFO

# =====================================================
# Security
# =====================================================
API_KEY=your-secret-api-key-here-change-in-production

# =====================================================
# Supabase Configuration
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# LLM Provider Configuration
# Choose one: openai, huggingface, anthropic
# =====================================================
LLM_PROVIDER=openai

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# HuggingFace (if LLM_PROVIDER=huggingface)
# HF_API_TOKEN=hf_your-huggingface-token-here

# Anthropic (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =====================================================
# LLM Model Configuration
# =====================================================
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=200
LLM_TIMEOUT=10

# =====================================================
# Retry Configuration
# =====================================================
MAX_RETRIES=3
RETRY_BACKOFF=2.0

# =====================================================
# Feature Flags
# =====================================================
ENABLE_METRICS=true
ENABLE_CONFIDENCE_SCORES=false

# =====================================================
# CORS Configuration
# Comma-separated list of allowed origins
# =====================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
